@model IEnumerable<RestaurantManagement.Models.MonAn>
@{ViewData["Title"]="Quản lý món ăn";}
<div class="d-flex justify-content-between align-items-center mb-4"><h1 class="h3">Quản lý món ăn</h1><a asp-action="Create" class="btn btn-primary">+ Thêm món</a></div>
<div class="table-responsive card"><table class="table align-middle mb-0"><thead><tr><th>Ảnh</th><th>Món ăn</th><th>Danh mục</th><th>Giá</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>@foreach(var m in Model){<tr><td>@if(!string.IsNullOrWhiteSpace(m.HinhAnh)){<img src="@m.HinhAnh" alt="@m.TenMon" width="88" height="66" style="object-fit:cover;border-radius:8px" loading="lazy"/>}else{<span class="text-muted small">Chưa có ảnh</span>}</td><td><strong>@m.TenMon</strong></td><td>@m.MaDanhMucNavigation.TenDanhMuc</td><td>@m.Gia.ToString("N0") ₫</td><td>@m.TrangThai</td><td><a asp-action="Edit" asp-route-id="@m.MaMon">Sửa</a> · <a asp-action="Delete" asp-route-id="@m.MaMon">Xóa</a></td></tr>}</tbody></table></div>
