@model RestaurantManagement.Models.GiuBan
@using RestaurantManagement.Services
@{ViewData["Title"]="Xác nhận đặt bàn";var lines=BookingWorkflow.Basket(Model);var total=BookingWorkflow.Total(lines);var deposit=BookingWorkflow.Deposit(lines);}
<section class="booking-page"><p class="eyebrow">XÁC NHẬN · THANH TOÁN GIẢ LẬP</p><h1>@ViewBag.Table.TenBan</h1><p>@Model.Ngay.ToString("dd/MM/yyyy") · @Model.Gio.ToString("HH:mm") · @Model.SoKhach khách</p><div id="hold-status" class="alert alert-warning" role="status">Đang kiểm tra thời gian giữ bàn…</div>
@if(lines.Count>0){<div class="table-responsive"><table class="table"><thead><tr><th>Món</th><th>SL</th><th>Sau giảm</th></tr></thead><tbody>@foreach(var l in lines){<tr><td>@l.TenMon @if(l.Giam>0){<small>−@l.Giam.ToString("0.##")%</small>}</td><td>@l.SoLuong</td><td>@((l.DonGia*l.SoLuong).ToString("N0")) ₫</td></tr>}</tbody></table></div><p>Tổng món: <strong>@total.ToString("N0") ₫</strong></p><p class="fs-4">Cọc 50%: <strong>@deposit.ToString("N0") ₫</strong></p><p class="text-muted">Thanh toán giả lập, không thu tiền thật. Tiền cọc được trừ khi thanh toán tại bàn.</p>}else{<p>Đặt bàn không kèm món — không cần đặt cọc.</p>}
<p class="small text-muted">Vui lòng check-in trong vòng 2 giờ từ giờ hẹn. Quá hạn, đặt bàn tự hủy và cọc giả lập được hoàn.</p><form asp-action="Confirm" method="post" data-checkout-hold><input type="hidden" id="hold-id" name="holdId" value="@Model.Id"/><button name="simulatedSuccess" value="true" id="continue-button" class="action-dark" disabled>@(lines.Count>0?"Xác nhận cọc (giả lập)":"Xác nhận đặt bàn")</button></form><a asp-action="Create" asp-route-hold="@Model.Id" class="btn mt-3">Quay lại chỉnh món</a><form asp-action="NhaBan" method="post"><input type="hidden" name="holdId" value="@Model.Id"/><button class="btn btn-link">Hủy giữ bàn</button></form></section>
@section Scripts {<script src="~/js/booking-hold.js" asp-append-version="true"></script>}
