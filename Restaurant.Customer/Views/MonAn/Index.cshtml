@model IEnumerable<RestaurantManagement.Models.MonAn>
@{ViewData["Title"]=ViewBag.Moi==true?"Món mới":"Thực đơn";var categories=(IEnumerable<RestaurantManagement.Models.DanhMucMon>)ViewBag.DanhMuc;int? selected=ViewBag.Category;}
@section Styles {<link rel="stylesheet" href="~/css/menu.css" asp-append-version="true"/>}
<section class="menu-page"><header class="menu-intro"><div><p class="menu-eyebrow">TỪ GIAN BẾP CỦA CHÚNG TÔI</p><h1>Hương vị cho<br/>mọi cuộc hẹn.</h1><p class="menu-lead">Khám phá thực đơn, chọn món yêu thích và hẹn một bữa ăn cùng những người thân yêu.</p></div><a asp-controller="BanAn" asp-action="Index" class="menu-book">Đặt bàn cho bữa ăn của bạn <span aria-hidden="true">↗</span></a></header>
<form method="get" class="menu-search"><input type="hidden" name="moi" value="@(ViewBag.Moi==true?"true":"false")"/><input name="danhMuc" value="@selected" type="hidden"/><label for="menu-q" class="visually-hidden">Tìm tên món</label><input id="menu-q" name="q" value="@ViewBag.Query" maxlength="100" placeholder="Bạn muốn thưởng thức món gì?"/><label for="menu-sort" class="visually-hidden">Sắp xếp</label><select id="menu-sort" name="sapXep"><option value="">Theo tên món</option><option value="gia-tang" selected="@(ViewBag.Sort=="gia-tang")">Giá gốc thấp đến cao</option><option value="gia-giam" selected="@(ViewBag.Sort=="gia-giam")">Giá gốc cao đến thấp</option></select><button>Tìm món</button></form>
<nav class="menu-categories" aria-label="Danh mục món"><a asp-action="Index" asp-route-moi="@ViewBag.Moi" asp-route-q="@ViewBag.Query" asp-route-sapXep="@ViewBag.Sort" class="@(!selected.HasValue?"is-active":"")">Tất cả</a>@foreach(var c in categories){<a asp-action="Index" asp-route-danhMuc="@c.MaDanhMuc" asp-route-moi="@ViewBag.Moi" asp-route-q="@ViewBag.Query" asp-route-sapXep="@ViewBag.Sort" class="@(selected==c.MaDanhMuc?"is-active":"")">@c.TenDanhMuc</a>}</nav>
<div class="menu-results"><h2>@(ViewBag.Moi==true?"Món mới từ gian bếp":"Thực đơn của nhà hàng")</h2><span>@ViewBag.Count món</span></div>
@if(!Model.Any()){<div class="menu-empty"><h3>Chưa tìm thấy món phù hợp</h3><p>Thử một từ khóa khác hoặc xem toàn bộ thực đơn.</p><a asp-action="Index">Xem tất cả món</a></div>}
<div class="menu-grid">@foreach(var m in Model){<article class="dish-card"><a class="dish-media" asp-action="Details" asp-route-id="@m.MaMon" aria-label="Xem @m.TenMon"><div class="dish-placeholder" aria-hidden="true"><svg viewBox="0 0 100 100" width="88" height="88" fill="none" stroke="currentColor" stroke-width="2"><circle cx="50" cy="50" r="29"/><circle cx="50" cy="50" r="20"/><path d="M8 17v25m6-25v25m6-25v25M8 35q6 12 12 0M14 44v40M88 17v67m0-67q-15 18 0 30"/></svg><span>Hương vị đang chờ bạn</span></div>@if(!string.IsNullOrWhiteSpace(m.HinhAnh)){<img src="@m.HinhAnh" alt="@m.TenMon" loading="lazy" decoding="async" data-dish-image/>}</a><div class="dish-body">@if(m.NgayThem>=RestaurantManagement.Models.BookingRules.Now.AddDays(-30)){<span class="new-dish">Món mới</span>}<p class="dish-category">@m.MaDanhMucNavigation.TenDanhMuc</p><h3><a asp-action="Details" asp-route-id="@m.MaMon">@m.TenMon</a></h3><p class="dish-description">@(string.IsNullOrWhiteSpace(m.MoTa)?"Khám phá hương vị tại nhà hàng.":m.MoTa)</p><div class="dish-footer"><partial name="_DishPrice" model="m" /><a asp-action="Details" asp-route-id="@m.MaMon" aria-label="Chi tiết @m.TenMon">Chi tiết <span aria-hidden="true">↗</span></a></div></div></article>}</div>
@if(ViewBag.Pages>1){<nav class="menu-pages" aria-label="Phân trang thực đơn">@if(ViewBag.Page>1){<a asp-action="Index" asp-route-moi="@ViewBag.Moi" asp-route-q="@ViewBag.Query" asp-route-danhMuc="@selected" asp-route-sapXep="@ViewBag.Sort" asp-route-page="@(ViewBag.Page-1)">← Trang trước</a>}<span>Trang @ViewBag.Page / @ViewBag.Pages</span>@if(ViewBag.Page<ViewBag.Pages){<a asp-action="Index" asp-route-moi="@ViewBag.Moi" asp-route-q="@ViewBag.Query" asp-route-danhMuc="@selected" asp-route-sapXep="@ViewBag.Sort" asp-route-page="@(ViewBag.Page+1)">Trang sau →</a>}</nav>}
</section>
@section Scripts {<script>document.querySelectorAll('[data-dish-image]').forEach(img=>{img.addEventListener('error',()=>img.hidden=true);if(img.complete&&!img.naturalWidth)img.hidden=true;});</script>}
