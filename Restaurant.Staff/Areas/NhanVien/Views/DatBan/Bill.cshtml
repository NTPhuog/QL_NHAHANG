@model RestaurantManagement.Models.DatBan
@{ViewData["Title"]="Hóa đơn "+Model.MaHoaDon;}
<style>@@media print{body *{visibility:hidden}#receipt,#receipt *{visibility:visible}#receipt{position:absolute;left:0;top:0;width:100%;border:0!important}.no-print{display:none!important}}</style>
<article class="card p-4 mx-auto" style="max-width:900px" id="receipt"><h1 class="h3">NHÀ HÀNG · HÓA ĐƠN</h1><p>Điện thoại: @(Model.MaKhachHangNavigation.SoDienThoai??"Chưa cập nhật")</p><p><strong>@Model.MaHoaDon</strong></p><p>@Model.MaBanNavigation.TenBan · @Model.MaKhachHangNavigation.HoTen · @Model.SoLuongKhach khách</p><p>Mã đặt bàn: @Model.MaCheckIn</p><p>Ngày xuất: @(Model.KetThucUtc?.AddHours(7).ToString("dd/MM/yyyy HH:mm"))</p><partial name="_OrderLines" model="Model"/><p class="text-success fw-bold">ĐÃ HOÀN TẤT · Đã thu tại bàn @Model.DaThuTaiBan.ToString("N0") ₫</p><small>Phiếu thanh toán nội bộ · Tiền cọc giả lập.</small><p class="mt-3">Cảm ơn quý khách. Hẹn gặp lại!</p></article><div class="no-print text-center mt-4"><button type="button" onclick="window.print()" class="btn btn-primary">In hóa đơn / Lưu PDF</button> <a asp-action="Index" class="btn btn-outline-dark">Về danh sách đang phục vụ</a> <a asp-action="Index" asp-route-archive="true" class="btn btn-link">Lịch sử hóa đơn</a></div>
