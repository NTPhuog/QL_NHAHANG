<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RestaurantManagement</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RestaurantManagement.styles.css" asp-append-version="true" />
</head>
<body>
<header class="main-header">
    <nav class="navbar">
        <a class="logo" asp-controller="Home" asp-action="Index">
            RESTAURANT
        </a>

        <div class="nav-links">
            <a asp-controller="Home" asp-action="Index">Trang chủ</a>
            <a asp-controller="MonAn" asp-action="Index">Thực đơn</a>
            <a asp-controller="BanAn" asp-action="Index">Bàn ăn</a>
            <a asp-controller="KhuyenMai" asp-action="Index">Khuyến mãi</a>
        </div>

        <div class="nav-account">

    @if (Context.Session.GetInt32("MaKhachHang") != null)
    {
        <span style="color:white; margin-right:15px;">
            Xin chào,
            @Context.Session.GetString("HoTen")
        </span>

        <a class="btn-login"
           asp-controller="TaiKhoan"
           asp-action="DangXuat">
            Đăng xuất
        </a>
    }
    else
    {
        <a class="btn-login"
           asp-controller="TaiKhoan"
           asp-action="DangNhap">
            Đăng nhập
        </a>
    }

</div>
    </nav>
</header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - RestaurantManagement - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
