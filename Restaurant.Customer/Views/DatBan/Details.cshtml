@model RestaurantManagement.Models.DatBan
@{ViewData["Title"]="Chi tiết đặt bàn";}
<section class="booking-page" style="max-width:900px"><h1>@Model.MaBanNavigation.TenBan</h1>@if(RestaurantManagement.Services.BookingNotices.Message(Model,RestaurantManagement.Models.BookingRules.Now) is string notice){<p class="alert alert-warning fw-semibold">@notice</p>}<p>Điện thoại: @(Model.MaKhachHangNavigation.SoDienThoai??"Chưa cập nhật")</p><p>@Model.NgayDat.ToString("dd/MM/yyyy") · @Model.GioDat.ToString("HH:mm") · @Model.SoLuongKhach khách</p><p>Trạng thái: <strong>@Model.TrangThai</strong></p><p>Mã đặt bàn: <strong class="font-monospace">@Model.MaCheckIn</strong></p>@if(Model.TrangThai=="Đã hủy"){<p class="text-danger">@Model.LyDoHuy</p>}@if(Model.TrangThai is "Đã duyệt" or "Chờ xác nhận"){<p class="text-muted">Check-in trước @(Model.NgayDat.ToDateTime(Model.GioDat).AddHours(2).ToString("HH:mm · dd/MM/yyyy")); quá hạn đơn sẽ tự hủy.</p><img src="@Url.Action("Qr",new{id=Model.MaDatBan})" width="220" height="220" alt="QR check-in"/><p>Đưa QR hoặc mã trên cho lễ tân khi đến giờ hẹn.</p>}
<h2 class="h4 mt-4">Món đã chọn</h2><div class="table-responsive"><table class="table"><thead><tr><th>Món</th><th>SL</th><th>Giá gốc</th><th>Giảm</th><th>Thành tiền</th></tr></thead><tbody>@foreach(var l in Model.CacMon){<tr><td>@l.TenMon <small>@(l.DatTruoc?"(Đặt trước)":"")</small></td><td>@l.SoLuong</td><td>@l.GiaGoc.ToString("N0")</td><td>@l.Giam.ToString("0.##")%</td><td>@((l.DonGia*l.SoLuong).ToString("N0")) ₫</td></tr>}</tbody></table></div><p>Tổng sau giảm: <strong>@Model.TongTien.ToString("N0") ₫</strong></p><p>Cọc giả lập: @Model.TienCoc.ToString("N0") ₫ @(Model.CocDaHoan?"— Đã hoàn":"")</p>
@if(Model.MaHoaDon!=null){<p>Hóa đơn: <strong>@Model.MaHoaDon</strong></p><p>Đã thu tại bàn: @Model.DaThuTaiBan.ToString("N0") ₫ · Hoàn tất</p>}else if(Model.TrangThai!="Đã hủy"){<p>Còn thanh toán: <strong>@Model.ConLai.ToString("N0") ₫</strong></p>}
@if(Model.TrangThai is "Đã duyệt" or "Chờ xác nhận"){<form asp-action="HuyDon" method="post"><input name="id" value="@Model.MaDatBan" type="hidden"/><button class="btn btn-outline-danger">Hủy đặt bàn</button></form>}<a asp-action="LichSu" class="btn mt-3">Lịch sử đặt bàn</a></section>
