@{ViewData["Title"]="Đăng nhập Admin";Layout="/Views/Shared/_BackOfficeLayout.cshtml";}
<section class="card p-4 mx-auto" style="max-width:480px"><h1 class="h3">Đăng nhập Admin</h1><p>Ứng dụng dành riêng cho admin.</p>@if(ViewBag.Loi!=null){<div class="alert alert-danger">@ViewBag.Loi</div>}
<form asp-area="" asp-controller="TaiKhoan" asp-action="DangNhap" method="post"><input name="returnUrl" value="@ViewBag.ReturnUrl" type="hidden"/><label for="email">Email</label><input id="email" name="email" type="email" required autocomplete="username" class="form-control"/><label for="password">Mật khẩu</label><input id="password" name="matKhau" type="password" required autocomplete="current-password" class="form-control"/><button class="btn btn-primary w-100 mt-4">Đăng nhập</button></form></section>

