@model IEnumerable<RestaurantManagement.Models.DatBan>
@{ViewData["Title"]="Lịch sử đặt bàn";}
<h1 class="my-4">Lịch sử đặt bàn</h1><p>Đưa mã QR hoặc mã đặt bàn cho lễ tân. Bạn có thể check-in sớm khi bàn sẵn sàng.</p>
@foreach(var d in Model.OrderByDescending(x=>RestaurantManagement.Services.BookingNotices.Due(x,RestaurantManagement.Models.BookingRules.Now))){<article class="card p-4 mb-3"><div class="d-flex flex-wrap justify-content-between gap-3"><div><h2 class="h4">@d.MaBanNavigation.TenBan</h2><p>Điện thoại: @(d.MaKhachHangNavigation.SoDienThoai??"Chưa cập nhật")</p>@if(RestaurantManagement.Services.BookingNotices.Message(d,RestaurantManagement.Models.BookingRules.Now) is string notice){<p class="alert alert-warning fw-semibold">@notice</p>}<p>@d.NgayDat.ToString("dd/MM/yyyy") · @d.GioDat.ToString("HH:mm") · @d.SoLuongKhach khách</p><p><strong>@d.TrangThai</strong></p><p>Mã đặt bàn: <strong class="font-monospace">@d.MaCheckIn</strong></p><p>Cọc giả lập: @d.TienCoc.ToString("N0") ₫ @(d.CocDaHoan?"· Đã hoàn cọc":"")</p><a asp-action="Details" asp-route-id="@d.MaDatBan" class="btn btn-outline-dark">Chi tiết / hóa đơn</a>@if(d.TrangThai=="Đã hủy"){<p class="text-danger">@d.LyDoHuy</p>}@if(d.TrangThai is "Đã duyệt" or "Chờ xác nhận"){<p class="text-muted">Check-in trước @(d.NgayDat.ToDateTime(d.GioDat).AddHours(2).ToString("HH:mm · dd/MM/yyyy")); quá hạn đơn sẽ tự hủy.</p>}</div>@if(d.TrangThai is "Đã duyệt" or "Chờ xác nhận"){<img src="@Url.Action("Qr",new{id=d.MaDatBan})" width="180" height="180" alt="QR check-in đơn @d.MaDatBan"/>}</div></article>}
@if(!Model.Any()){<p>Bạn chưa đặt bàn. <a asp-controller="BanAn" asp-action="Index">Chọn bàn ngay</a></p>}
