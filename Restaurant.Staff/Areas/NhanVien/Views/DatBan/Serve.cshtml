@model RestaurantManagement.Models.DatBan
@using RestaurantManagement.Models
@{ViewData["Title"]="Gọi món & tính tiền";var menu=(List<MonAn>)ViewBag.Menu;var discounts=(Dictionary<int,decimal>)ViewBag.Discounts;}
<h1 class="h3">@Model.MaBanNavigation.TenBan · @Model.MaKhachHangNavigation.HoTen</h1><p>Điện thoại: @(Model.MaKhachHangNavigation.SoDienThoai??"Chưa cập nhật")</p><p>Đang phục vụ · @Model.SoLuongKhach khách · @Model.MaCheckIn</p><div class="row g-4"><section class="col-xl-5"><div class="card p-4"><h2 class="h4">Thêm món khách yêu cầu</h2><form asp-action="AddDish" method="post"><input type="hidden" name="id" value="@Model.MaDatBan"/><input type="hidden" name="requestId" value="@Guid.NewGuid()"/><label for="dish" class="form-label">Món trong thực đơn</label><select name="maMon" id="dish" class="form-select" required><option value="">Chọn món</option>@foreach(var m in menu){var off=discounts.GetValueOrDefault(m.MaMon);<option value="@m.MaMon">@m.TenMon — @PromotionPricing.DiscountedPrice(m.Gia,off).ToString("N0") ₫ @(off>0?$"(Giảm {off:0.##}%)":"")</option>}</select><label for="quantity" class="form-label mt-3">Số lượng</label><input id="quantity" name="soLuong" type="number" min="1" max="99" value="1" required class="form-control"/><button class="btn btn-primary mt-3">Thêm vào hóa đơn</button></form><p class="small text-muted mt-3">Món gọi thêm áp dụng ưu đãi đang hiệu lực. Giá món đã xác nhận được giữ nguyên.</p></div></section><section class="col-xl-7"><div class="card p-4"><h2 class="h4">Chi tiết hóa đơn tạm tính</h2><partial name="_OrderLines" model="Model"/><form asp-action="Finish" method="post"><input name="id" type="hidden" value="@Model.MaDatBan"/><input name="expectedTotal" type="hidden" value="@Model.TongTien.ToString("0",System.Globalization.CultureInfo.InvariantCulture)"/><p>Xác nhận sau khi đã nhận đủ tiền.</p><button class="btn btn-success" disabled="@(!Model.CacMon.Any())">Đã thu @Model.ConLai.ToString("N0") ₫ · Xuất hóa đơn</button></form></div></section></div>
