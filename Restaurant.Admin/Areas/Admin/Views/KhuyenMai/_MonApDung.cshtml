@{var dishes=(IEnumerable<RestaurantManagement.Models.MonAn>)ViewBag.MonAn;var selected=(HashSet<int>)ViewBag.SelectedIds;}
<fieldset class="border rounded p-3 mt-4"><legend class="float-none w-auto px-2 fs-6">Món áp dụng khuyến mãi</legend><p class="text-muted small">Chọn ít nhất một món. Chỉ những món được chọn mới có giá ưu đãi; món Ẩn/Hết món không xuất hiện ở thực đơn khách.</p>
@if(!dishes.Any()){<p class="text-danger">Chưa có món ăn. <a asp-controller="MonAn" asp-action="Create">Thêm món ăn trước</a>.</p>}else{<label for="dish-filter" class="visually-hidden">Tìm món trong danh sách</label><input id="dish-filter" class="form-control mb-3" placeholder="Tìm tên món…" type="search"/><div class="d-flex gap-2 mb-2"><button class="btn btn-sm btn-outline-secondary" type="button" data-select-dishes="true">Chọn các món đang hiện</button><button class="btn btn-sm btn-outline-secondary" type="button" data-select-dishes="false">Bỏ chọn đang hiện</button></div><div style="max-height:320px;overflow:auto">@foreach(var dish in dishes){<label class="d-flex gap-2 align-items-center border-bottom py-2" data-dish-choice data-name="@dish.TenMon"><input type="checkbox" class="form-check-input m-0" name="maMonApDung" value="@dish.MaMon" checked="@selected.Contains(dish.MaMon)"/><span class="flex-grow-1">@dish.TenMon <small class="text-muted">(@dish.TrangThai)</small></span><span>@dish.Gia.ToString("N0") ₫</span></label>}</div><p id="dish-count" class="small mt-2 mb-0" aria-live="polite"></p>}
</fieldset>
<script>
(()=>{const rows=[...document.querySelectorAll('[data-dish-choice]')], search=document.getElementById('dish-filter'), count=document.getElementById('dish-count');if(!search)return;const normalize=s=>s.toLocaleLowerCase('vi').normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/đ/g,'d');const update=()=>count.textContent=`Đã chọn ${rows.filter(r=>r.querySelector('input').checked).length} món`;search.addEventListener('input',()=>rows.forEach(r=>{r.style.setProperty('display',normalize(r.dataset.name).includes(normalize(search.value))?'flex':'none','important')}));document.querySelectorAll('[data-select-dishes]').forEach(b=>b.addEventListener('click',()=>{rows.filter(r=>r.style.display!=='none').forEach(r=>r.querySelector('input').checked=b.dataset.selectDishes==='true');update()}));rows.forEach(r=>r.querySelector('input').addEventListener('change',update));update();})();
</script>
