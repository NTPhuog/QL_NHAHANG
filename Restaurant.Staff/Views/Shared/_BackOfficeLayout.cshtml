@{var admin=Context.Session.GetString("Role")=="Admin";var signedIn=Context.Session.GetInt32("UserId")!=null;var title=!signedIn?"CỔNG NỘI BỘ":admin?"QUẢN TRỊ NHÀ HÀNG":"KHU VỰC NHÂN VIÊN";}
<!DOCTYPE html><html lang="vi"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] · @title</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/><style>body{background:#f4f6f8;color:#192435}header{background:#192435;color:white}a{text-underline-offset:3px}label{margin-top:12px;font-weight:600}.card{border-color:#e0e5eb}main{min-height:80vh}</style></head><body>
<header class="px-4 py-3 d-flex justify-content-between align-items-center flex-wrap gap-3"><a class="text-white fw-bold text-decoration-none" href="@(admin?"/Admin":"/NhanVien")">@title</a>@if(signedIn){<div class="d-flex align-items-center gap-3"><span>@Context.Session.GetString("HoTen")</span><form asp-area="" asp-controller="TaiKhoan" asp-action="DangXuat" method="post"><button class="btn btn-outline-light btn-sm">Đăng xuất</button></form></div>}</header>
<main class="container-fluid px-4 py-4">@if(TempData["ThongBao"] is string message){<div class="alert alert-success" role="status">@message</div>}@if(TempData["Loi"] is string error){<div class="alert alert-danger" role="alert">@error</div>}@if(signedIn){<section id="booking-notices" data-url="/NhanVien/DatBan/Notifications" data-staff="true" aria-live="polite" aria-label="Khách sắp đến" hidden></section>}@RenderBody()</main>
<script src="~/lib/jquery/dist/jquery.min.js"></script><script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script><script src="~/js/booking-notices.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>

