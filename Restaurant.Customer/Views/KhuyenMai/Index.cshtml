@model IEnumerable<RestaurantManagement.Models.KhuyenMai>
@{ViewData["Title"]="Khuyến mãi";}
<section class="py-4"><h1>Ưu đãi cho bữa ăn của bạn</h1><p class="text-muted mb-4">Mỗi món được áp dụng mức giảm cao nhất đang có hiệu lực.</p>@if(!Model.Any()){<div class="alert alert-light">Hiện chưa có khuyến mãi áp dụng.</div>}<div class="row g-4">@foreach(var item in Model){<div class="col-md-6 col-xl-4"><partial name="_Promotion" model="item" /></div>}</div><a asp-controller="MonAn" asp-action="Index" class="btn btn-dark mt-4">Khám phá thực đơn</a></section>
