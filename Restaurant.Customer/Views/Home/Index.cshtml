@model IEnumerable<RestaurantManagement.Models.MonAn>
@{ViewData["Title"]="Hương vị & những cuộc hẹn";}
<section class="home-feature"><div class="home-copy"><p class="eyebrow">CHÀO MỪNG ĐẾN NHÀ HÀNG</p><h1>Bữa ăn ngon.<br/>Khoảnh khắc<br/>đáng nhớ.</h1><p>Món ngon từ gian bếp, không gian ấm cúng và một chỗ ngồi dành riêng cho cuộc hẹn của bạn.</p><a asp-controller="BanAn" asp-action="Index" class="action-dark">Đặt bàn ngay →</a><a asp-controller="MonAn" asp-action="Index" class="secondary">Khám phá thực đơn</a></div><img src="/uploads/gallery/restaurant.png" alt="Không gian nhà hàng — ảnh minh họa" fetchpriority="high"/></section>
<section class="home-section"><div class="section-line"><div><p class="eyebrow">MỚI TỪ GIAN BẾP</p><h2>Thêm hương vị, thêm lựa chọn.</h2></div><a asp-controller="MonAn" asp-action="Index" asp-route-moi="true">Xem tất cả món mới →</a></div><div class="home-new-grid">@foreach(var dish in Model){<article class="home-dish"><a asp-controller="MonAn" asp-action="Details" asp-route-id="@dish.MaMon">@if(!string.IsNullOrWhiteSpace(dish.HinhAnh)){<img src="@dish.HinhAnh" alt="@dish.TenMon" loading="lazy"/>}</a><div><span class="new-dish">Món mới</span><h3><a asp-controller="MonAn" asp-action="Details" asp-route-id="@dish.MaMon">@dish.TenMon</a></h3><partial name="_DishPrice" model="dish"/></div></article>}</div>@if(!Model.Any()){<p>Gian bếp đang chuẩn bị những món mới. Mời bạn khám phá thực đơn hiện có.</p>}</section>
<section class="home-note"><div><p class="eyebrow">KHÔNG GIAN CHO MỌI CUỘC HẸN</p><h2>Từ hai người đến cả gia đình.</h2><p class="mb-0">Chọn ngày, giờ và xem bàn còn trống trước khi đặt.</p></div><a asp-controller="BanAn" asp-action="Index" class="action-dark">Chọn không gian →</a></section>
