@{
    ViewData["Title"] = "Trang chủ";
}

<section class="hero">
    <div class="hero-overlay"></div>

    <div class="hero-content">
        <span class="hero-small">CHÀO MỪNG ĐẾN VỚI</span>

        <h1>Restaurant</h1>

        <p>
            Không gian ấm cúng, thực đơn phong phú
            và trải nghiệm đặt bàn nhanh chóng.
        </p>

        <div class="hero-actions">
            <a asp-controller="BanAn"
               asp-action="Index"
               class="btn-primary-custom">
                ĐẶT BÀN NGAY
            </a>

            <a asp-controller="MonAn"
               asp-action="Index"
               class="btn-outline-custom">
                XEM THỰC ĐƠN
            </a>
        </div>
    </div>
</section>


<section class="intro-section">
    <div class="section-title">
        <span>KHÁM PHÁ</span>
        <h2>Trải nghiệm tại nhà hàng</h2>
        <p>
            Thưởng thức những món ăn hấp dẫn trong
            không gian thoải mái và hiện đại.
        </p>
    </div>

    <div class="feature-grid">

        <div class="feature-card">
            <div class="feature-icon">🍽️</div>
            <h3>Thực đơn đa dạng</h3>
            <p>
                Nhiều món ăn được lựa chọn và
                cập nhật thường xuyên.
            </p>

            <a asp-controller="MonAn"
               asp-action="Index">
                Xem thực đơn →
            </a>
        </div>


        <div class="feature-card">
            <div class="feature-icon">🪑</div>
            <h3>Không gian thoải mái</h3>
            <p>
                Nhiều loại bàn phù hợp với nhóm
                nhỏ, gia đình hoặc bạn bè.
            </p>

            <a asp-controller="BanAn"
               asp-action="Index">
                Chọn bàn →
            </a>
        </div>


        <div class="feature-card">
            <div class="feature-icon">🎁</div>
            <h3>Khuyến mãi</h3>
            <p>
                Theo dõi các chương trình ưu đãi
                mới nhất của nhà hàng.
            </p>

            <a asp-controller="KhuyenMai"
               asp-action="Index">
                Xem ưu đãi →
            </a>
        </div>

    </div>
</section>


<section class="booking-banner">

    <div>
        <span>ĐẶT CHỖ NHANH CHÓNG</span>

        <h2>
            Sẵn sàng cho một bữa ăn tuyệt vời?
        </h2>

        <p>
            Chọn bàn phù hợp và gửi yêu cầu đặt bàn
            chỉ trong vài bước.
        </p>
    </div>

    <a asp-controller="BanAn"
       asp-action="Index"
       class="btn-primary-custom">
        CHỌN BÀN
    </a>

</section>