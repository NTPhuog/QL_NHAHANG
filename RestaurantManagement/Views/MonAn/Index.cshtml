@model IEnumerable<RestaurantManagement.Models.MonAn>
@{ViewData["Title"]="Thực đơn";}
<h1>Thực đơn</h1>@if(!Model.Any()){<p>Thực đơn đang được cập nhật.</p>}
<div class="row g-3">@foreach(var m in Model){<div class="col-md-4"><article class="card p-4 h-100"><small>@m.MaDanhMucNavigation.TenDanhMuc</small><h2 class="h4">@m.TenMon</h2><p>@m.MoTa</p><strong>@m.Gia.ToString("N0") ₫</strong></article></div>}</div>
