@model RestaurantManagement.Models.MonAn
@{ViewData["Title"]="Thông tin món ăn";}
<h1 class="h3 mb-3">Thông tin món ăn</h1><form asp-action="Create" method="post" enctype="multipart/form-data" class="card p-4"><div asp-validation-summary="All" class="text-danger" role="alert"></div>
<div class="row g-4"><div class="col-lg-7"><label asp-for="TenMon">Tên món</label><input asp-for="TenMon" maxlength="100" required class="form-control"/>
<label asp-for="MaDanhMuc">Danh mục</label><select asp-for="MaDanhMuc" asp-items="ViewBag.MaDanhMuc" required class="form-select"><option value="">Chọn danh mục</option></select><small>Nếu chưa có danh mục, <a asp-controller="DanhMucMon" asp-action="Create">tạo danh mục trước</a>.</small>
<label asp-for="Gia">Giá (đồng)</label><input asp-for="Gia" type="number" step="0.01" min="0.01" max="999999999" required class="form-control"/>
<label asp-for="MoTa">Mô tả</label><textarea asp-for="MoTa" maxlength="255" rows="3" class="form-control"></textarea>
<label asp-for="TrangThai">Trạng thái</label><select asp-for="TrangThai" class="form-select"><option>Hiển thị</option><option>Ẩn</option><option>Hết món</option></select></div>
<div class="col-lg-5"><label for="anhTaiLen">Ảnh món ăn</label><p class="small text-muted">JPG, PNG hoặc WebP, tối đa 5 MB. Để trống để giữ ảnh hiện tại.</p><input id="anhTaiLen" name="anhTaiLen" type="file" accept="image/jpeg,image/png,image/webp" class="form-control" data-image-input/><div class="mt-3 rounded bg-light overflow-hidden"><img src="@Model.HinhAnh" alt="Xem trước ảnh món ăn" data-image-preview style="width:100%;aspect-ratio:4/3;object-fit:cover" hidden="@(string.IsNullOrWhiteSpace(Model.HinhAnh))"/></div><p data-image-error class="text-danger small mt-2" role="alert"></p></div></div>
<div class="mt-4"><button class="btn btn-primary">Lưu món</button><a asp-action="Index" class="btn">Quay lại</a></div></form>
@section Scripts {<script src="~/js/image-upload.js" asp-append-version="true"></script>}
