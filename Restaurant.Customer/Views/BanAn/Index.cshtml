@model RestaurantManagement.CustomerModels.TableSelection
@using RestaurantManagement.CustomerModels
@{ViewData["Title"]="Chọn không gian & đặt bàn";var groups=new[]{2,6,12,24};var visible=Model.Group.HasValue?Model.Tables.Where(x=>x.Group==Model.Group):Enumerable.Empty<TableOption>();}
<section class="reserve-intro"><p class="eyebrow">MỘT CHỖ NGỒI · NHIỀU KỶ NIỆM</p><h1>Chọn không gian<br/>cho cuộc hẹn của bạn.</h1><p>Từ bữa tối hai người đến buổi sum họp đông đủ. Mỗi lượt đặt bàn kéo dài 2 giờ.</p></section>
<ol class="booking-steps"><li class="active">01 · Ngày & giờ</li><li>02 · Không gian & bàn</li><li>03 · Xác nhận yêu cầu</li></ol>
<form method="get" class="slot-form"><div asp-validation-summary="All" class="text-danger slot-errors" role="alert"></div><input type="hidden" name="loai" value="@Model.Group"/><label>Ngày đến<input type="date" name="ngay" value="@Model.Date.ToString("yyyy-MM-dd")" min="@DateOnly.FromDateTime(RestaurantManagement.Models.BookingRules.Now).ToString("yyyy-MM-dd")" required/></label><label>Giờ đến<input type="time" name="gio" value="@Model.Time.ToString("HH:mm")" min="10:00" max="20:00" required/></label><label>Số khách<input type="number" name="khach" value="@Model.Guests" min="1" max="24" required/></label><button class="action-dark">Xem bàn phù hợp →</button></form>
<div class="section-line"><div><p class="eyebrow">CHỌN LOẠI BÀN</p><h2>Không gian cho mọi dịp</h2></div><span>@Model.Tables.Count bàn · 4 loại không gian</span></div>
<div class="space-grid">@foreach(var group in groups){var tables=Model.Tables.Where(x=>x.Group==group).ToList();<a class="space-card @(Model.Group==group?"selected":"")" asp-action="Index" asp-route-loai="@group" asp-route-ngay="@Model.Date.ToString("yyyy-MM-dd")" asp-route-gio="@Model.Time.ToString("HH:mm")" asp-route-khach="@Model.Guests" asp-fragment="table-list"><img src="/uploads/gallery/table-@(group).png" alt="Không gian @TableSelection.Label(group)"/><div><span class="eyebrow">@tables.Count BÀN</span><h3>@TableSelection.Label(group)</h3><p>@TableSelection.Zone(group)</p><strong>@(Model.Valid?$"{tables.Count(x=>x.Available&&x.Table.SoChoNgoi>=Model.Guests)} bàn phù hợp còn trống":"Chọn lại thời gian") <span>↗</span></strong></div></a>}</div>
<section id="table-list" class="table-section">@if(Model.Group.HasValue){<div class="section-line"><div><p class="eyebrow">CHỌN BÀN CỤ THỂ</p><h2>@TableSelection.Label(Model.Group.Value)</h2></div><p>@Model.Date.ToString("dd/MM/yyyy") · @Model.Time.ToString("HH:mm")–@Model.Time.AddHours(2).ToString("HH:mm")</p></div><p class="text-muted">Chọn bàn còn trống. Bạn có 5 phút để hoàn tất đặt bàn.</p><div class="table-grid">@foreach(var option in visible){var b=option.Table;var fit=b.SoChoNgoi>=Model.Guests;<article class="table-card" data-table-id="@b.MaBan"><img src="@(b.HinhAnh??$"/uploads/gallery/table-{option.Group}.png")" alt="Ảnh minh họa @b.TenBan" loading="lazy"/><div class="table-content"><span class="table-status @(option.Available?"available":"occupied")">@(Model.Valid?option.Status:"Chưa kiểm tra")</span><h3>@b.TenBan</h3><p class="table-location">@(b.ViTri??"Vui lòng hỏi nhân viên về vị trí")</p><p>Tối đa <strong>@b.SoChoNgoi khách</strong> · 2 giờ / lượt</p>@if(Model.Valid&&option.Available&&fit){<a class="action-dark" asp-controller="DatBan" asp-action="Create" asp-route-maBan="@b.MaBan" asp-route-ngay="@Model.Date.ToString("yyyy-MM-dd")" asp-route-gio="@Model.Time.ToString("HH:mm")" asp-route-khach="@Model.Guests">Đặt bàn này →</a>}else{<button class="action-dark" disabled>@(!Model.Valid?"Chọn lại thời gian":!fit?"Không đủ chỗ":option.Status)</button>}</div></article>}</div>@if(!visible.Any()){<p>Chưa có bàn thuộc nhóm này.</p>}}else{<div class="choose-hint">Chọn một loại bàn phía trên để xem vị trí và trạng thái từng bàn.</div>}</section>
<p class="small text-muted mt-4">Ảnh không gian mang tính minh họa.</p>
@section Scripts {<script src="~/js/table-status.js" asp-append-version="true"></script>}

