@model IEnumerable<RestaurantManagement.Models.DatBan>
@{ViewData["Title"]="Tiếp đón & phục vụ";bool archive=ViewBag.Archive==true;}
<div class="d-flex flex-wrap gap-3 justify-content-between mb-4"><div><h1 class="h2">@(archive?"Lịch sử & hóa đơn":"Tiếp đón & phục vụ")</h1><p>Tiếp nhận khách, gọi món và thanh toán.</p></div><a asp-action="CheckIn" class="btn btn-primary align-self-start">Quét QR / nhập mã check-in</a></div>
<div class="mb-4"><a asp-action="Index" class="btn btn-outline-dark">Đơn đang hoạt động</a> <a asp-action="Index" asp-route-archive="true" class="btn btn-outline-dark">Lịch sử / hóa đơn</a></div>
<form method="get" class="row g-2 mb-4"><input type="hidden" name="archive" value="@archive.ToString().ToLowerInvariant()"/><div class="col-md-4"><input name="q" class="form-control" placeholder="Tên, số điện thoại, mã đặt bàn hoặc hóa đơn" value="@Context.Request.Query["q"]" aria-label="Tìm đơn"/></div><div class="col-md-3"><input name="ngay" type="date" class="form-control" value="@Context.Request.Query["ngay"]" aria-label="Ngày đặt"/></div><div class="col"><button class="btn btn-dark">Tìm kiếm</button></div></form>
<div class="row g-3">@foreach(var d in Model.OrderByDescending(x=>RestaurantManagement.Services.BookingNotices.Due(x,RestaurantManagement.Models.BookingRules.Now))){<div class="col-lg-6"><article class="card p-4 h-100"><span class="badge bg-secondary align-self-start">@d.TrangThai</span><h2 class="h4 mt-3">@d.MaBanNavigation.TenBan · @d.MaKhachHangNavigation.HoTen</h2><p>Điện thoại: @(d.MaKhachHangNavigation.SoDienThoai??"Chưa cập nhật")</p>@if(RestaurantManagement.Services.BookingNotices.Message(d,RestaurantManagement.Models.BookingRules.Now) is string notice){<p class="alert alert-warning fw-semibold">@notice</p>}<p>@d.NgayDat.ToString("dd/MM/yyyy") · @d.GioDat.ToString("HH:mm") · @d.SoLuongKhach khách</p><p class="font-monospace">@d.MaCheckIn</p><p>Cọc: @d.TienCoc.ToString("N0") ₫ @(d.CocDaHoan?"(Đã hoàn giả lập)":"")</p>@if(d.TrangThai=="Đã hủy"){<p class="text-danger">@d.LyDoHuy</p>}@if(d.TrangThai=="Đang phục vụ"){<a asp-action="Serve" asp-route-id="@d.MaDatBan" class="btn btn-success">Gọi món / tính tiền</a>}else if(d.MaHoaDon!=null){<a asp-action="Bill" asp-route-id="@d.MaDatBan" class="btn btn-outline-primary">Xem @d.MaHoaDon</a>}else if(d.TrangThai is "Đã duyệt" or "Chờ xác nhận"){<p class="text-muted">Có thể check-in sớm khi bàn sẵn sàng.</p><details><summary>Hủy đơn</summary><form asp-action="Huy" method="post" class="mt-2"><input type="hidden" name="id" value="@d.MaDatBan"/><input name="lyDoHuy" maxlength="255" required placeholder="Lý do hủy" class="form-control"/><button class="btn btn-outline-danger mt-2">Hủy đặt bàn</button></form></details>}</article></div>}</div>@if(!Model.Any()){<p>Không có đơn trong danh sách này.</p>}
