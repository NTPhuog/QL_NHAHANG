<!DOCTYPE html><html lang="vi"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] · Nhà hàng</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/></head><body>
<header class="main-header"><nav class="navbar container gap-3"><a class="logo" href="/">RESTAURANT</a><div class="nav-links d-flex gap-3 flex-wrap"><a href="/MonAn">Thực đơn</a><a href="/BanAn">Đặt bàn</a><a href="/KhuyenMai">Khuyến mãi</a>


@if(Context.Session.GetString("Role")=="KhachHang"){<a href="/DatBan/LichSu">Lịch sử đặt bàn</a>}
</div><div class="nav-account">@if(Context.Session.GetInt32("UserId")!=null){<span class="text-white">@Context.Session.GetString("HoTen")</span><form asp-area="" asp-controller="TaiKhoan" asp-action="DangXuat" method="post" class="d-inline"><button class="btn btn-outline-light ms-2">Đăng xuất</button></form>}else{<a class="btn-login" href="/TaiKhoan/DangNhap">Đăng nhập</a>}</div></nav></header>
<div class="container py-4"><main>@if(TempData["ThongBao"] is string message){<div class="alert alert-success" role="status">@message</div>}@if(TempData["Loi"] is string error){<div class="alert alert-danger" role="alert">@error</div>}@RenderBody()</main></div><footer class="border-top p-4 text-center text-muted">Nhà hàng · Đặt bàn trực tuyến</footer><script src="~/lib/jquery/dist/jquery.min.js"></script><script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script><script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>


