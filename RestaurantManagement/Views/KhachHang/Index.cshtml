@model IEnumerable<RestaurantManagement.Models.KhachHang>
<h1>Khách hàng</h1><form method="get"><input name="q" placeholder="Tên hoặc email" value="@Context.Request.Query["q"]"/><button class="btn">Tìm</button></form><div class="table-responsive"><table class="table"><thead><tr><th>Họ tên</th><th>Email</th><th>Điện thoại</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>@foreach(var u in Model){<tr><td>@u.HoTen</td><td>@u.Email</td><td>@u.SoDienThoai</td><td>@u.TrangThai</td><td><form asp-action="TrangThai" method="post"><input name="id" value="@u.MaKhachHang" type="hidden"/><input name="trangThai" value="@(u.TrangThai=="Hoạt động"?"Khóa":"Hoạt động")" type="hidden"/><button class="btn btn-outline-secondary">@(u.TrangThai=="Hoạt động"?"Khóa":"Mở khóa")</button></form></td></tr>}</tbody></table></div>
