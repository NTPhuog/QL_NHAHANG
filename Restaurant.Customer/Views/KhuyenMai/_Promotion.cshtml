@model RestaurantManagement.Models.KhuyenMai
<article class="card h-100 border-0 shadow-sm"><div class="card-body p-4"><span class="badge bg-danger mb-3">Giảm @Model.PhanTramGiam?.ToString("0.##")%</span><h2 class="h4">@Model.TenKhuyenMai</h2><p>@Model.MoTa</p><p class="text-muted small">Từ @Model.NgayBatDau.ToString("dd/MM/yyyy") đến @Model.NgayKetThuc.ToString("dd/MM/yyyy")</p><h3 class="h6 mt-4">Áp dụng cho các món</h3><ul class="list-group list-group-flush">@foreach(var link in Model.MonApDung.OrderBy(x=>x.MonAn.TenMon)){<li class="list-group-item px-0"><a asp-controller="MonAn" asp-action="Details" asp-route-id="@link.MaMon">@link.MonAn.TenMon</a></li>}</ul></div></article>
