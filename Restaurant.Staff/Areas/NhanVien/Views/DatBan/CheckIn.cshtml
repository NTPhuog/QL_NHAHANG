@{ViewData["Title"]="Check-in khách hàng";}
<section class="card p-4 mx-auto" style="max-width:720px"><h1 class="h3">Check-in bằng mã đặt bàn</h1><p>Quét QR hoặc nhập mã đặt bàn để đón khách.</p><form asp-action="CheckIn" method="post" id="check-in-form"><div asp-validation-summary="All" class="text-danger" role="alert"></div><label for="check-in-code" class="form-label">Mã đặt bàn</label><input id="check-in-code" name="code" class="form-control font-monospace" placeholder="NH-…" maxlength="32" required autocomplete="off" autofocus/><button class="btn btn-primary mt-3">Check-in khách</button></form><hr/><div class="d-flex gap-2"><button type="button" id="scan-start" class="btn btn-outline-dark">Bật camera quét QR</button><button type="button" id="scan-stop" class="btn btn-outline-secondary" hidden>Dừng camera</button></div><video id="qr-video" muted playsinline hidden class="mt-3 rounded" style="width:100%;max-height:340px"></video><label for="qr-file" class="form-label mt-3">Hoặc chọn ảnh QR từ máy</label><input id="qr-file" type="file" accept="image/*" class="form-control"/><p id="scan-message" class="text-muted mt-3" role="status">Có thể dùng máy quét QR dạng bàn phím tại ô mã.</p><a asp-action="Index" class="mt-3">Quay lại danh sách</a></section>
@section Scripts {<script src="~/lib/jsqr/jsQR.js"></script><script src="~/js/check-in.js" asp-append-version="true"></script>}
