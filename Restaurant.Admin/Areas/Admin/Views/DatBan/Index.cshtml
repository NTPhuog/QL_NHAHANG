@model IEnumerable<RestaurantManagement.Models.DatBan>
@{ViewData["Title"]="Điều phối đặt bàn";}
<h1>Điều phối đặt bàn</h1><p>Có thể nhận khách trước giờ hẹn khi bàn sẵn sàng.</p><form method="get" class="d-flex gap-2 flex-wrap mb-4"><input type="date" name="ngay" value="@Context.Request.Query["ngay"]" aria-label="Ngày"/><input name="q" value="@Context.Request.Query["q"]" placeholder="Tên / số điện thoại"/><select name="trangThai" aria-label="Trạng thái"><option value="">Tất cả trạng thái</option>@foreach(var state in new[]{"Chờ xác nhận","Đã duyệt","Đang phục vụ","Hoàn thành","Đã hủy"}){<option selected="@(Context.Request.Query["trangThai"]==state)">@state</option>}</select><button class="btn btn-primary">Lọc</button><a asp-action="Index">Bỏ lọc</a></form>
@if(!Model.Any()){<p>Không có đơn phù hợp.</p>}
@foreach(var d in Model){<article class="card p-3 mb-3"><h2 class="h5">#@d.MaDatBan · @d.MaKhachHangNavigation.HoTen · @d.MaBanNavigation.TenBan</h2><p>@d.NgayDat.ToString("dd/MM/yyyy") lúc @d.GioDat.ToString("HH:mm") · @d.SoLuongKhach khách · @d.MaKhachHangNavigation.SoDienThoai</p><strong>@d.TrangThai</strong><p>@d.GhiChu</p><p>@d.LyDoHuy</p><div class="d-flex gap-2 flex-wrap">
@if(d.TrangThai=="Chờ xác nhận"){<form method="post" asp-action="Duyet"><input name="id" value="@d.MaDatBan" type="hidden"/><button class="btn btn-success">Duyệt</button></form>}
@if(d.TrangThai=="Đã duyệt"){<form method="post" asp-action="NhanBan"><input name="id" value="@d.MaDatBan" type="hidden"/><button class="btn btn-primary">Khách nhận bàn</button></form>}
@if(d.TrangThai=="Đang phục vụ"){<form method="post" asp-action="HoanThanh"><input name="id" value="@d.MaDatBan" type="hidden"/><button class="btn btn-success">Hoàn thành</button></form>}
@if(d.TrangThai is "Chờ xác nhận" or "Đã duyệt"){<form method="post" asp-action="Huy"><input name="id" value="@d.MaDatBan" type="hidden"/><input name="lyDoHuy" maxlength="255" required placeholder="Lý do hủy"/><button class="btn btn-outline-danger">Hủy đơn</button></form>}
</div></article>}

