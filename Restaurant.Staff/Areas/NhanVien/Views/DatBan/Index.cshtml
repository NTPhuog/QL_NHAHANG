
@model IEnumerable<RestaurantManagement.Models.DatBan>

@{
    ViewData["Title"] = "Điều phối đặt bàn";

    var danhSach = Model.ToList();
    var tongDon = danhSach.Count;
    var choXacNhan = danhSach.Count(x => x.TrangThai == "Chờ xác nhận");
    var daDuyet = danhSach.Count(x => x.TrangThai == "Đã duyệt");
    var dangPhucVu = danhSach.Count(x => x.TrangThai == "Đang phục vụ");
    var hoanThanh = danhSach.Count(x => x.TrangThai == "Hoàn thành");

    var trangThaiLoc = Context.Request.Query["trangThai"].ToString();
}

<style>
    .booking-page {
        font-family: 'Segoe UI', sans-serif;
        color: #243047;
        padding: 10px 0 40px;
    }

    .booking-hero {
        background: linear-gradient(120deg, #182c49, #294e72);
        color: white;
        border-radius: 20px;
        padding: 30px 34px;
        margin-bottom: 25px;
        box-shadow: 0 10px 30px rgba(23, 46, 76, .15);
    }

    .booking-hero h1 {
        font-size: 28px;
        font-weight: 750;
        margin-bottom: 10px;
    }

    .booking-hero p {
        color: #cbd9e8;
        margin: 0;
        font-size: 14px;
        line-height: 1.7;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 15px;
        margin-bottom: 25px;
    }

    .stat-card {
        background: white;
        padding: 20px;
        border-radius: 15px;
        border: 1px solid #e9edf3;
        box-shadow: 0 4px 16px rgba(0,0,0,.035);
        border-bottom: 3px solid var(--accent);
    }

    .stat-card .stat-label {
        font-size: 12px;
        color: #78869a;
        font-weight: 600;
    }

    .stat-card .stat-number {
        font-size: 30px;
        font-weight: 750;
        color: var(--accent);
        margin-top: 8px;
    }

    .filter-panel {
        background: white;
        border: 1px solid #e8edf4;
        padding: 22px;
        border-radius: 17px;
        margin-bottom: 25px;
        box-shadow: 0 4px 16px rgba(0,0,0,.035);
    }

    .section-heading {
        font-weight: 700;
        font-size: 17px;
        margin-bottom: 18px;
    }

    .filter-grid {
        display: grid;
        grid-template-columns: 1fr 1.5fr 1.2fr auto auto;
        gap: 12px;
        align-items: end;
    }

    .filter-field label {
        font-size: 12px;
        font-weight: 650;
        color: #64748b;
        margin-bottom: 7px;
        display: block;
    }

    .booking-page .form-control,
    .booking-page .form-select {
        min-height: 43px;
        border-radius: 9px;
        border: 1px solid #dce4ee;
        font-size: 14px;
    }

    .booking-page .form-control:focus,
    .booking-page .form-select:focus {
        border-color: #537da8;
        box-shadow: 0 0 0 3px rgba(83,125,168,.12);
    }

    .booking-list {
        display: grid;
        gap: 18px;
    }

    .booking-card {
        background: white;
        border: 1px solid #e6ebf2;
        border-radius: 17px;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(0,0,0,.035);
        transition: transform .2s, box-shadow .2s;
    }

    .booking-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 9px 25px rgba(0,0,0,.07);
    }

    .booking-card-header {
        padding: 20px 24px;
        border-bottom: 1px solid #edf0f5;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        flex-wrap: wrap;
    }

    .booking-id {
        color: #8290a3;
        font-size: 12px;
        font-weight: 650;
        margin-bottom: 5px;
    }

    .booking-name {
        font-size: 19px;
        font-weight: 750;
        margin: 0;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        border-radius: 30px;
        padding: 8px 13px;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

    .status-waiting {
        background: #fff4d9;
        color: #a66b00;
    }

    .status-approved {
        background: #e4efff;
        color: #245cb5;
    }

    .status-serving {
        background: #e7e5ff;
        color: #6548c3;
    }

    .status-completed {
        background: #dcf8e9;
        color: #198451;
    }

    .status-cancelled {
        background: #ffe6e8;
        color: #c43c4a;
    }

    .status-default {
        background: #eef1f5;
        color: #526174;
    }

    .booking-card-body {
        padding: 22px 24px;
    }

    .booking-info {
        display: grid;
        grid-template-columns: repeat(4, minmax(0,1fr));
        gap: 20px;
    }

    .info-label {
        font-size: 12px;
        color: #8b97a8;
        margin-bottom: 7px;
    }

    .info-value {
        font-size: 14px;
        font-weight: 650;
        color: #2d3b50;
        overflow-wrap: anywhere;
    }

    .booking-note {
        margin-top: 20px;
        background: #f6f8fb;
        border-left: 3px solid #94a8c0;
        border-radius: 8px;
        padding: 12px 15px;
        font-size: 13px;
        color: #536276;
    }

    .cancel-note {
        background: #fff2f2;
        border-left-color: #e66a73;
        color: #b54750;
    }

    .booking-card-footer {
        background: #fafbfd;
        border-top: 1px solid #edf0f5;
        padding: 16px 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 14px;
    }

    .booking-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        align-items: center;
    }

    .booking-actions form {
        margin: 0;
    }

    .booking-actions .btn,
    .filter-grid .btn {
        border-radius: 9px;
        font-size: 13px;
        font-weight: 650;
        padding: 10px 17px;
        min-height: 43px;
    }

    .btn-navy {
        background: #254d75;
        color: white;
        border: 1px solid #254d75;
    }

    .btn-navy:hover {
        background: #193b5d;
        color: white;
    }

    .cancel-form {
        display: flex;
        gap: 9px;
        flex-wrap: wrap;
    }

    .cancel-form input {
        min-width: 180px;
        max-width: 260px;
    }

    .empty-state {
        text-align: center;
        padding: 65px 20px;
        background: white;
        border: 1px dashed #cbd5e1;
        border-radius: 17px;
    }

    .empty-state h3 {
        font-size: 19px;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .empty-state p {
        color: #8490a0;
        margin-bottom: 0;
    }

    @@media(max-width: 1100px) {
        .stats-grid {
            grid-template-columns: repeat(3, 1fr);
        }

        .filter-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .booking-info {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media(max-width: 600px) {
        .booking-hero {
            padding: 24px 20px;
        }

        .booking-hero h1 {
            font-size: 23px;
        }

        .stats-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .stat-card {
            padding: 15px;
        }

        .filter-grid {
            grid-template-columns: 1fr;
        }

        .booking-info {
            grid-template-columns: 1fr 1fr;
            gap: 17px;
        }

        .booking-card-header,
        .booking-card-body,
        .booking-card-footer {
            padding: 17px;
        }

        .cancel-form,
        .cancel-form input {
            width: 100%;
            max-width: none;
        }
    }
</style>

<div class="booking-page">

    <!-- TIÊU ĐỀ -->
    <div class="booking-hero">
        <div style="font-size:12px;letter-spacing:2px;opacity:.7;margin-bottom:10px">
            RESTAURANT MANAGEMENT
        </div>

        <h1>Điều phối đặt bàn</h1>

        <p>
            Quản lý, xác nhận và theo dõi các lượt đặt bàn của khách hàng.
            <br />
            Khách được nhận bàn từ giờ hẹn đến trước khi hết lượt 2 giờ.
            Bàn đang phục vụ cần hoàn thành lượt cũ trước.
        </p>
    </div>

    <!-- THỐNG KÊ -->
    <div class="stats-grid">

        <div class="stat-card" style="--accent:#254d75">
            <div class="stat-label">Tổng đơn</div>
            <div class="stat-number">@tongDon</div>
        </div>

        <div class="stat-card" style="--accent:#d59b28">
            <div class="stat-label">Chờ xác nhận</div>
            <div class="stat-number">@choXacNhan</div>
        </div>

        <div class="stat-card" style="--accent:#3479ca">
            <div class="stat-label">Đã duyệt</div>
            <div class="stat-number">@daDuyet</div>
        </div>

        <div class="stat-card" style="--accent:#7556c9">
            <div class="stat-label">Đang phục vụ</div>
            <div class="stat-number">@dangPhucVu</div>
        </div>

        <div class="stat-card" style="--accent:#21966a">
            <div class="stat-label">Hoàn thành</div>
            <div class="stat-number">@hoanThanh</div>
        </div>

    </div>

    <!-- BỘ LỌC -->
    <div class="filter-panel">

        <div class="section-heading">
            Tìm kiếm & bộ lọc
        </div>

        <form method="get" asp-action="Index" class="filter-grid">

            <div class="filter-field">
                <label>Ngày đặt bàn</label>
                <input type="date"
                       name="ngay"
                       class="form-control"
                       value="@Context.Request.Query["ngay"]" />
            </div>

            <div class="filter-field">
                <label>Khách hàng</label>
                <input type="text"
                       name="q"
                       class="form-control"
                       placeholder="Tên hoặc số điện thoại..."
                       value="@Context.Request.Query["q"]" />
            </div>

            <div class="filter-field">
                <label>Trạng thái</label>

                <select name="trangThai" class="form-select">
                    <option value="">Tất cả trạng thái</option>

                    @foreach (var state in new[]
                    {
                        "Chờ xác nhận",
                        "Đã duyệt",
                        "Đang phục vụ",
                        "Hoàn thành",
                        "Đã hủy"
                    })
                    {
                        <option value="@state"
                                selected="@(trangThaiLoc == state)">
                            @state
                        </option>
                    }
                </select>
            </div>

            <button type="submit" class="btn btn-navy">
                Tìm kiếm
            </button>

            <a asp-action="Index" class="btn btn-outline-secondary">
                Xóa lọc
            </a>

        </form>
    </div>

    <!-- DANH SÁCH -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="section-heading mb-0">
            Danh sách đặt bàn
        </h2>

        <span class="text-muted small">
            Hiển thị @tongDon đơn
        </span>
    </div>

    @if (!danhSach.Any())
    {
        <div class="empty-state">
            <div style="font-size:42px;margin-bottom:15px">📋</div>
            <h3>Không tìm thấy đơn đặt bàn</h3>
            <p>Hãy thử thay đổi bộ lọc hoặc tìm kiếm khác.</p>
        </div>
    }
    else
    {
        <div class="booking-list">

            @foreach (var d in danhSach)
            {
                var statusClass = d.TrangThai switch
                {
                    "Chờ xác nhận" => "status-waiting",
                    "Đã duyệt" => "status-approved",
                    "Đang phục vụ" => "status-serving",
                    "Hoàn thành" => "status-completed",
                    "Đã hủy" => "status-cancelled",
                    _ => "status-default"
                };

                <article class="booking-card">

                    <!-- HEADER -->
                    <div class="booking-card-header">

                        <div>
                            <div class="booking-id">
                                MÃ ĐẶT BÀN #@d.MaDatBan
                            </div>

                            <h3 class="booking-name">
                                @(d.MaKhachHangNavigation?.HoTen ?? "Khách hàng")
                            </h3>
                        </div>

                        <span class="status-badge @statusClass">
                            <span>●</span>
                            @d.TrangThai
                        </span>

                    </div>

                    <!-- THÔNG TIN -->
                    <div class="booking-card-body">

                        <div class="booking-info">

                            <div>
                                <div class="info-label">Bàn đặt</div>
                                <div class="info-value">
                                    @(d.MaBanNavigation?.TenBan ?? "Chưa xác định")
                                </div>
                            </div>

                            <div>
                                <div class="info-label">Ngày & giờ</div>
                                <div class="info-value">
                                    @d.NgayDat.ToString("dd/MM/yyyy")
                                    <br />
                                    @d.GioDat.ToString("HH:mm")
                                </div>
                            </div>

                            <div>
                                <div class="info-label">Số lượng khách</div>
                                <div class="info-value">
                                    @d.SoLuongKhach người
                                </div>
                            </div>

                            <div>
                                <div class="info-label">Số điện thoại</div>
                                <div class="info-value">
                                    @(d.MaKhachHangNavigation?.SoDienThoai ?? "Chưa có")
                                </div>
                            </div>

                        </div>

                        @if (!string.IsNullOrWhiteSpace(d.GhiChu))
                        {
                            <div class="booking-note">
                                <strong>Ghi chú:</strong> @d.GhiChu
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(d.LyDoHuy))
                        {
                            <div class="booking-note cancel-note">
                                <strong>Lý do hủy:</strong> @d.LyDoHuy
                            </div>
                        }

                    </div>

                    <!-- THAO TÁC -->
                    <div class="booking-card-footer">

                        <div class="text-muted small">
                            Đơn đặt bàn #@d.MaDatBan
                        </div>

                        <div class="booking-actions">

                            @if (d.TrangThai == "Chờ xác nhận")
                            {
                                <form method="post" asp-action="Duyet">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@d.MaDatBan" />

                                    <button type="submit" class="btn btn-success">
                                        ✓ Duyệt đơn
                                    </button>
                                </form>
                            }

                            @if (d.TrangThai == "Đã duyệt")
                            {
                                <form method="post" asp-action="NhanBan">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@d.MaDatBan" />

                                    <button type="submit" class="btn btn-navy">
                                        Khách nhận bàn
                                    </button>
                                </form>
                            }

                            @if (d.TrangThai == "Đang phục vụ")
                            {
                                <form method="post" asp-action="HoanThanh">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@d.MaDatBan" />

                                    <button type="submit" class="btn btn-success">
                                        ✓ Hoàn thành
                                    </button>
                                </form>
                            }

                            @if (d.TrangThai == "Chờ xác nhận" ||
                                 d.TrangThai == "Đã duyệt")
                            {
                                <form method="post"
                                      asp-action="Huy"
                                      class="cancel-form">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@d.MaDatBan" />

                                    <input type="text"
                                           name="lyDoHuy"
                                           class="form-control"
                                           maxlength="255"
                                           required
                                           placeholder="Nhập lý do hủy..." />

                                    <button type="submit"
                                            class="btn btn-outline-danger"
                                            onclick="return confirm('Bạn có chắc muốn hủy đơn này?')">
                                        Hủy đơn
                                    </button>

                                </form>
                            }

                        </div>

                    </div>

                </article>
            }

        </div>
    }

</div>


