@model RestaurantManagement.Models.MonAn
@{ViewData["Title"]=Model.TenMon;}
<div class="row g-4 py-4"><div class="col-md-6">@if(!string.IsNullOrWhiteSpace(Model.HinhAnh)){<img src="@Model.HinhAnh" alt="@Model.TenMon" class="rounded-4" style="width:100%;aspect-ratio:4/3;object-fit:cover"/>}else{<div class="rounded-4 p-5 bg-light text-center">Ảnh món đang được cập nhật</div>}</div><div class="col-md-6"><p class="text-muted">@Model.MaDanhMucNavigation.TenDanhMuc</p><h1>@Model.TenMon</h1><div class="fs-4 my-4"><partial name="_DishPrice" model="Model" /></div><p>@Model.MoTa</p><a asp-controller="BanAn" asp-action="Index" class="btn btn-dark mt-3">Đặt bàn</a><a asp-action="Index" class="btn mt-3">Quay lại thực đơn</a></div></div>
